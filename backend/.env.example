# ==============================================================================
# CONFIGURATION D'ENVIRONNEMENT — INTELLIGENT DOCUMENT EXTRACTOR (BACKEND)
# ==============================================================================

# Clé API OpenRouter pour l'extraction intelligente de factures et l'assistant IA
OPENROUTER_API_KEY=votre_cle_openrouter_ici

# Chaîne de connexion MongoDB Atlas (avec protocole mongodb+srv://)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Clé secrète pour la signature cryptographique des tokens JWT (min. 32 caractères aléatoires)
JWT_SECRET_KEY=cle_secrete_jwt_aleatoire_a_generer_pour_la_production

# Liste des emails autorisés pour le rôle Administrateur (séparés par des virgules)
ADMIN_EMAILS=admin@votre-domaine.com

# Clé et Identifiant de Voix ElevenLabs pour la synthèse vocale (TTS)
ELEVENLABS_API_KEY=votre_cle_elevenlabs_ici
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Origines CORS autorisées (séparées par des virgules, optionnel en dev)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chemins spécifiques vers les binaires externes (optionnel si dans le PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Release-24.08.0-0\poppler-24.08.0\Library\bin
